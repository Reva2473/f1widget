<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">ApexGrid</string>

    <!-- Widget Titles and Descriptions -->
    <string name="widget_next_race_title">Next Grand Prix</string>
    <string name="widget_next_race_desc">Round countdown, date range, circuit stats (laps, length, corners), and race start time for the upcoming Grand Prix.</string>

    <string name="widget_weekend_schedule_title">Weekend Schedule</string>
    <string name="widget_weekend_schedule_desc">Full Friday to Sunday session schedule (FP1, FP2, Quali, Race) in your local timezone.</string>

    <string name="widget_driver_standings_title">Driver Standings (WDC)</string>
    <string name="widget_driver_standings_desc">Top World Drivers championship rankings (P1–P5), team badges, race wins, and points.</string>

    <string name="widget_constructor_standings_title">Constructor Standings (WCC)</string>
    <string name="widget_constructor_standings_desc">Top World Constructors championship standings (P1–P5), team car silhouettes, points, and gap to P1.</string>

    <string name="widget_favorite_driver_title">Favorite Driver</string>
    <string name="widget_favorite_driver_desc">Championship standing, points, race wins, team badge, and recent form summary for your chosen driver.</string>

    <string name="widget_favorite_team_title">Favorite Team</string>
    <string name="widget_favorite_team_desc">Constructor standing, total points, race wins, team car silhouette, and driver lineup points split for your chosen team.</string>

    <string name="widget_last_race_podium_title">Last Race Podium</string>
    <string name="widget_last_race_podium_desc">P1–P3 podium finishers, winning gap, and tyre stint strategies from the most recent Grand Prix.</string>

    <string name="widget_live_timing_title">Live Timing Banner</string>
    <string name="widget_live_timing_desc">Live session code, time remaining, track status, and P1 leader best and last lap times.</string>

    <string name="widget_loading">Loading race data…</string>

    <!-- Notification Channels -->
    <string name="notification_channel_session_reminders_name">Race Session Reminders</string>
    <string name="notification_channel_session_reminders_desc">Alerts before Qualifying, Sprint, and Grand Prix session starts.</string>

