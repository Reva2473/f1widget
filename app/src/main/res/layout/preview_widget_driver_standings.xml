                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_drv_2_team"
                android:textColor="@color/apex_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

